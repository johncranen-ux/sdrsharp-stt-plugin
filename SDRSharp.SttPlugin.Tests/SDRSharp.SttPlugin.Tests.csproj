<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Linked directly rather than via ProjectReference: the main plugin project targets
    net9.0-windows/x86 and pulls in the SDR# SDK + WinForms. These source files are pure
    logic with no dependency on either, so linking keeps the test project portable and
    fast to run under `dotnet test`.
  -->
  <ItemGroup>
    <Compile Include="..\SDRSharp.SttPlugin\Dsp\Decimator.cs" Link="Src\Decimator.cs" />
    <Compile Include="..\SDRSharp.SttPlugin\Dsp\BiquadFilters.cs" Link="Src\BiquadFilters.cs" />
    <Compile Include="..\SDRSharp.SttPlugin\Dsp\Normalizer.cs" Link="Src\Normalizer.cs" />
    <Compile Include="..\SDRSharp.SttPlugin\Dsp\VoiceActivityDetector.cs" Link="Src\VoiceActivityDetector.cs" />
    <Compile Include="..\SDRSharp.SttPlugin\WavBuilder.cs" Link="Src\WavBuilder.cs" />
    <Compile Include="..\SDRSharp.SttPlugin\WhisperClient.cs" Link="Src\WhisperClient.cs" />
    <Compile Include="..\SDRSharp.SttPlugin\PluginSettings.cs" Link="Src\PluginSettings.cs" />
  </ItemGroup>

</Project>
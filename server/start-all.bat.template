@echo off
setlocal

:: ============================================================
:: SDRSharp STT Plugin — Server Startup Script
:: Copy this file to start-all.bat and fill in your API keys.
:: start-all.bat is git-ignored so keys are never committed.
:: ============================================================

:: -- API Keys (edit these) -----------------------------------
set ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE
:: AISHUB_USERNAME is the username/API key from AISHub's welcome mail. You only get one by
:: contributing an AIS feed to AISHub -- signing up alone is not enough. AIS_SOURCE defaults
:: to aishub below, so this is needed for vessel enrichment out of the box.
set AISHUB_USERNAME=YOUR_AISHUB_USERNAME_HERE
set AISSTREAM_API_KEY=YOUR_AISSTREAM_KEY_HERE
set GROQ_API_KEY=gsk_YOUR_GROQ_KEY_HERE

:: -- STT backend ---------------------------------------------
:: groq        = Groq's hosted Whisper API (default). No GPU involved.
:: whisper_cpp = local whisper.cpp server on the RX 7900 XTX in WSL2.
::
:: ROLLBACK: change this one line to whisper_cpp and restart to go back to the
:: local GPU. Nothing else needs changing; both paths are fully maintained.
set STT_BACKEND=groq
set GROQ_MODEL=whisper-large-v3

:: -- Vessel-identification filters (all default on) ----------
:: Uncomment one line to turn that fix off without touching code or git.
:: AIS_HINT_FILTER    - stops ordinary speech ("good day") being matched to real ships
:: AIS_NAME_FILTER    - stops a mis-heard name matching a short vessel spelled inside it
::                      ("Orason" -> RA); off restores the old WRatio scorer at cutoff 80
:: AIS_PARTIAL_CALLSIGN - identifies a vessel from a partly-garbled spelled-out callsign
::                      when a spoken name agrees; off restores exact-callsign matching only
:: PROMPT_ECHO_FILTER - drops transcriptions that are the decoding prompt read back
:: set AIS_HINT_FILTER=off
:: set AIS_NAME_FILTER=off
:: set AIS_PARTIAL_CALLSIGN=off
:: set RESOLVER_LIVE_CANDIDATES=off
:: set PROMPT_ECHO_FILTER=off
::
:: -- Shipped 2026-08-18, with their rollbacks ----------------
:: AIS_LIVE_MATCH_MAX_AGE_MIN bounds how old a vessel's AIS fix may be for the live pass to
:: re-offer it to the resolver. 360 minutes. Age counts from the last SUCCESSFUL AIS poll, not
:: the wall clock, so a stalled feed freezes the cutoff instead of ageing every ship out at
:: once -- six days were lost to a feed that failed quietly. Measured: precision 87.1 -> 88.3,
:: six false positives removed, no correct identification lost, spread 0.0 over three runs.
:: BELLONA is what it exists for -- a 122-hour-old inland barge 72 km away, named with high
:: confidence over a ship 12.8 km away that had reported seven minutes earlier.
:: ROLLBACK to the old unbounded behaviour:
:: set AIS_LIVE_MATCH_MAX_AGE_MIN=0
::
:: AIS_CALLSIGN_SUFFIX_FALLBACK tries the TAIL of a spelled-out callsign that decoded cleanly
:: but short -- "call SUNvictor seven" swallowed the V of V7B2710, leaving 7B2710, which the
:: exact lookup cannot match and the partial-pattern path declines as "not my problem". The
:: tail must fit exactly one cached callsign AND a resembling name must be spoken in the same
:: conversation. On by DECISION, not by measurement: its one bench arm was invalid rather than
:: negative. If identification regresses, THIS IS THE FIRST THING TO SWITCH OFF.
:: set AIS_CALLSIGN_SUFFIX_FALLBACK=off
::
:: AIS_SUGGEST shows, under a conversation nobody was identified in, the best few vessel names
:: found BELOW the identification cutoff, labelled unconfirmed. It never names anyone -- the
:: block is there because a reader who heard the audio can settle what the matcher cannot
:: ("Meld Them In" -> MELTEMI I). Right ship in the list 9 times out of 35; the other
:: three-quarters are near misses worth a glance and nothing more.
:: set AIS_SUGGEST=off
:: AIS_SUGGEST_N is how many are listed. 3 by default; 5 finds 3 more of the 35 at the cost of
:: two more wrong names to read each time.
:: set AIS_SUGGEST_N=5
::
:: AIS_SUGGEST_TIEBREAK ranks equally-scoring suggestions by plausibility instead of
:: arbitrarily. OFF: it could not be measured, because scoring proximity needs each vessel's
:: position AT THE TIME and a frozen cache keeps only the latest fix. Do not switch it on
:: expecting an improvement; switch it on to help measure one.
:: set AIS_SUGGEST_TIEBREAK=on
::
:: CONVERSATION_RESOLVER decides vessel identity after each exchange ends, from the whole
:: exchange, and publishes it at http://localhost:9000/conversations. It never touches the
:: live transcript. On by default.
:: set CONVERSATION_RESOLVER=off

:: -- AIS vessel source -----------------------------------------
:: AIS_SOURCE selects where vessel data comes from: aishub (default) polls AISHub's REST
:: webservice using AISHUB_USERNAME above; aisstream is the original aisstream.io websocket,
:: kept working as a rollback and needs AISSTREAM_API_KEY above; off disables vessel
:: enrichment entirely.
:: set AIS_SOURCE=aishub
::
:: AISHUB_BBOX is latmin,latmax,lonmin,lonmax. Deliberately wide -- a vessel is cached long
:: before it calls Rotterdam, at the cost of more duplicate vessel names to disambiguate.
:: set AISHUB_BBOX=51.0,53.2,2.0,6.0
::
:: AISHUB_POLL_SEC is seconds between polls. Values under 60 are raised to 60 in code
:: regardless of this setting, because AISHub answers a faster caller with no data at all.
:: set AISHUB_POLL_SEC=900

:: -- Ports (defaults match whisper proxy settings) -----------
:: Whisper-server listens on 8080 inside WSL (accessible as localhost:8080 from Windows)
:: Proxy listens on 9000; under STT_BACKEND=whisper_cpp it forwards to 8080
set WHISPER_BACKEND_PORT=8080
set PROXY_PORT=9000

:: -- Paths ---------------------------------------------------
:: %~dp0 is this script's own directory, so the proxy is found wherever you cloned the
:: repository and the file still works from a Desktop shortcut.
set SCRIPT_DIR=%~dp0
set PROXY_SCRIPT=%SCRIPT_DIR%whisper-proxy.py

:: -- Start whisper-server in WSL2 Ubuntu-22.04 ---------------
:: Only needed for the local backend — under groq there is nothing to start.
if /i not "%STT_BACKEND%"=="whisper_cpp" goto :start_proxy

echo [1/2] Starting whisper-server in WSL2 Ubuntu-22.04 (large-v3, port 8080)...
start "Whisper Server (WSL)" cmd /k wsl -d Ubuntu-22.04 -- bash -l -c "~/start-whisper-server.sh"

echo     Waiting 20 seconds for model to load into GPU VRAM...
timeout /t 20 /nobreak >nul

:start_proxy
:: -- Free the proxy port before binding ----------------------
:: Python's ThreadingHTTPServer sets allow_reuse_address (SO_REUSEADDR), so on Windows a
:: second proxy binds %PROXY_PORT% alongside the first, silently takes the port over, and
:: leaves the original running as a zombie -- so "restart it" quietly does nothing.
:: start-whisper-server.sh self-cleans :8080 for the same reason; this is the :9000 half.
for /f "tokens=5" %%p in ('netstat -ano ^| findstr ":%PROXY_PORT%" ^| findstr "LISTENING"') do (
    echo     Stopping existing proxy on port %PROXY_PORT% ^(pid %%p^)...
    taskkill /f /pid %%p >nul 2>&1
)

:: -- Start the Python proxy ----------------------------------
echo [2/2] Starting Whisper proxy (port %PROXY_PORT%, backend=%STT_BACKEND%)...
start "Whisper Proxy" cmd /k py "%PROXY_SCRIPT%"

echo.
echo Started.
echo   STT backend    : %STT_BACKEND%
echo   Proxy          : localhost:9000  (Windows)
echo.
echo SDRSharp plugin should connect to: http://localhost:9000
echo.
pause
